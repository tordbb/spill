+function sdkNextHintX(){
+  const lv=SDK_LEVELS[sdkCur];
+  /* Deterministic order keeps repeated help predictable. The hint only reveals
+     a cell that is truly empty and that the player has not marked yet. */
+  for(let r=0;r<6;r++)for(let c=0;c<6;c++){
+    const k=sdkKey(r,c);
+    if(lv.solution[r]!==c&&!sdkX.has(k)&&!sdkFound.has(k))return [r,c];
+  }
+  return null;
