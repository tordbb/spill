+/* Game-balance weights, not real-world employment statistics.
+   School 12% gives about one teacher per four children with FAMILY_EVERY=2.
+   A farm can support about four boutiques (2 deliveries/week × 2 weeks of stock),
+   matching the 13:50 farmer:shop-worker preference ratio. Office receives the remainder. */
+const CIT_JOB_WEIGHTS=[['O',25],['K',12],['S',50],['M',13]];
+function citPreferenceAt(percent){
+  let x=((percent%100)+100)%100, sum=0;
+  for(const [k,w] of CIT_JOB_WEIGHTS){sum+=w;if(x<sum)return k;}
+  return 'O';
+}
+function citRandomPreference(){ return citPreferenceAt(Math.floor(Math.random()*100)); }
