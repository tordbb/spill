+async function citFarmDriveW(w,toIdx,act){
+  if(!w.el){w.at=toIdx;return true;}citMovingPose(w.el);
+  const from=w.at!=null?w.at:toIdx;if(from===toIdx)return true;
+  const path=citRoute(from,toIdx,act);
+  if(!path){w.el.style.transition='';return false;}
+  const stepMs=Math.max(12,Math.round(CITY_CFG.WALK_STEP_MS/CITY_CFG.BUS_SPEED_MULT));
+  for(let k=1;k<path.length;k++){
+    const moveMs=citAnimMs(stepMs);
+    w.el.style.transition=`left ${moveMs}ms linear, top ${moveMs}ms linear`;
+    citPlacePerson(w.el,path[k],true);await citSleep(stepMs);
+  }
+  w.el.style.transition='';w.at=toIdx;return true;
